# Copy to .env and fill in. Never commit .env to GitHub.
PORT=3848

# OpenAI powers role-play replies, feedback, scenario inference, and microphone transcription.
OPENAI_API_KEY=your-openai-key-here
# Optional: defaults to gpt-4.1-mini for role-play replies and feedback.
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# Optional: defaults to gpt-4o-transcribe for stronger speech recognition.
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Optional: defaults to gpt-4o-mini-tts for agent voice playback.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Optional: set only if your OpenAI account requires a regional endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
